# Local Supabase (from `supabase status`). Cloud: the project's direct connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Model backend. claude-code (default) runs the local `claude` binary on your Claude subscription; api uses @anthropic-ai/sdk.
BRAIN_LLM=claude-code
BRAIN_CLAUDE_CODE_MODEL=opus
# Only for BRAIN_LLM=api or `brain backfill`.
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-opus-5
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-2.5
# Hard cap on Voyage tokens per UTC day, counted in this database's brain.provider_usage. A request that would pass it
# is refused before it is sent. 0 blocks every call. There is no off switch. Default 5000000.
BRAIN_VOYAGE_DAILY_TOKEN_CAP=5000000
# The same kind of cap for the eval database (brain_eval), counted in its own ledger. Default 1000000. Voyage bills
# the account, so the account-wide daily ceiling is BRAIN_VOYAGE_DAILY_TOKEN_CAP + BRAIN_EVAL_VOYAGE_DAILY_TOKEN_CAP.
BRAIN_EVAL_VOYAGE_DAILY_TOKEN_CAP=1000000
# US dollars per million tokens, copied from Voyage's pricing page, for the estimated cost in `brain usage`. 0 prints tokens only.
BRAIN_VOYAGE_PRICE_PER_MTOK_EMBED=0
BRAIN_VOYAGE_PRICE_PER_MTOK_RERANK=0
OBSIDIAN_VAULT_PATH=/Users/frankfu/Documents/Obsidian/General
OBSIDIAN_FOLDER=Brain
# Saves refresh the Obsidian mirror automatically while the vault exists; set to 0 to turn that off.
OBSIDIAN_AUTO=1
