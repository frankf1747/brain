node_modules/
.env
dist/
supabase/.temp/
supabase/.branches/
.DS_Store
# Real-corpus eval items quote the owner's private documents; the repository is public, so they stay on the owner's machine.
eval/golden-real.jsonl
eval/drafts-real.jsonl
eval/review/real/
# Any renamed real-corpus file (--golden or --drafts pointing elsewhere): <name>-real.jsonl anywhere under eval/.
eval/**/*-real.jsonl
# Any real/ directory under eval/ (a --review-dir pointing elsewhere puts real sheets in <dir>/real/).
eval/**/real/
